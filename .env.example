# Prefer `vercel env pull .env.local` after Development variables are complete.
# Local and Vercel Development use only the isolated development resources.
APP_ENV=development
NEON_PROJECT_ID=young-poetry-39424785

# Use the pooled development Neon connection for the application runtime.
DATABASE_URL=postgresql://user:password@host-pooler.example/database?sslmode=require

# Keep the development R2 bucket private. The owner currently reuses an
# account-wide R2 key across environments; keep it ignored and private.
# Runtime bucket validation does not reduce that credential's account access.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=my-business-development

# Use development-only authentication values.
AUTH_PASSWORD_HASH=replace-with-a-development-bcrypt-hash
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only development key. Never expose it through NEXT_PUBLIC_.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini

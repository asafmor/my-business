# Cloud access is production-only, including deliberate local access.
APP_ENV=production

# Use the pooled Neon connection for the application runtime.
DATABASE_URL=postgresql://user:password@host-pooler.example/database?sslmode=require

# Keep the production R2 bucket private.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=rotem

# Generate a high-entropy production value.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only; configured and verified in the AI integration issue.
OPENAI_API_KEY=replace-me

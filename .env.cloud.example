# Copy this file to .env.cloud.local. Never commit the local copy.

# Cloud resources are production-only.
APP_ENV=production

# Neon pooled URL for the application runtime.
DATABASE_URL=

# Authentication is configured only in Vercel Production. Generate values with
# the documented commands in README.md; never commit or reuse a raw password.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Neon direct production URL for migrations and pg_dump in GitHub Actions.
NEON_BACKUP_DATABASE_URL=

# Cloudflare R2 S3 credentials. Restrict the token to bucket rotem.
R2_ACCOUNT_ID=5ef1523db5fec7bd2868760c7dc9cd7c
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rotem

# Backblaze B2 S3 credentials. Use a bucket-restricted backup application key.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=rotem-backup
B2_BUCKET_ID=64d50e8e76b39173ad00031f

# Setup may temporarily require a separate admin/master key with writeKeys. Keep
# it only in the ignored local worksheet, and blank it after setup.
# B2_SETUP_KEY_ID=
# B2_SETUP_APPLICATION_KEY=

# Server-only. OPENAI_MODEL is optional and restricted to approved models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

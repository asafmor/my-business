# Prefer `vercel env pull .env.local` once Development variables are configured.
# This worksheet documents only the isolated development application runtime.
# Never commit a local copy or put a raw password in it.

# The runtime refuses any value other than development or production. Local work
# must use development and must never use production resource identifiers.
APP_ENV=development
NEON_PROJECT_ID=young-poetry-39424785

# Neon pooled development URL for application runtime and deliberate migrations.
DATABASE_URL=

# Development-only authentication values. Generate the hash interactively; do
# not store or document the raw password.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Cloudflare R2 S3 credentials. The owner currently reuses an account-wide key
# across environments; runtime validation limits the app bucket, not key scope.
R2_ACCOUNT_ID=5ef1523db5fec7bd2868760c7dc9cd7c
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=my-business-development

# Server-only development key. No B2 or direct production database URL belongs
# in local application runtime configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

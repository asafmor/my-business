{
  "name": "my-business",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "auth:hash-password": "tsx scripts/auth/generate-password-hash.ts",
    "auth:generate-session-secret": "tsx scripts/auth/generate-session-secret.ts",
    "cloud:check:environment": "node --env-file=.env.local --import tsx scripts/cloud/verify-environment.ts",
    "cloud:check:postgres": "tsx scripts/cloud/verify-postgres.ts",
    "cloud:check:r2": "tsx scripts/cloud/verify-object-store.ts r2",
    "cloud:check:b2": "tsx scripts/cloud/verify-object-store.ts b2",
    "cloud:inspect:b2": "tsx scripts/cloud/inspect-b2.ts",
    "cloud:configure:b2": "tsx scripts/cloud/configure-b2.ts",
    "cloud:finalize:b2": "tsx scripts/cloud/finalize-b2.ts",
    "cloud:sync:neon": "tsx scripts/cloud/sync-neon-worksheet.ts",
    "backup:verify-secrets": "tsx scripts/backup/verify-secrets.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/db/migrate.ts",
    "db:permanently-delete-document": "node --env-file=.env.local --import tsx scripts/db/permanently-delete-document.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
